<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  Pellucid's launch screen is a bare, theme-appropriate ground and nothing
  else. Apple's guidance is that a launch screen should be nearly identical
  to the app's first screen, with logos and text avoided, and the app's own
  first principle is that the manuscript is the only thing on screen — so
  there is deliberately no image here, not even the app icon.

  It used to hard-code pure white with a centred (empty, 68-byte placeholder)
  image view. That meant every launch on a dark theme — Midnight is
  #0F111A — flashed white and then snapped to near-black.

  systemBackgroundColor follows the device's light/dark appearance, which is
  the closest a STATIC storyboard can get: it cannot know which of Pellucid's
  themes the user picked. It is right for the common cases (a light theme in
  light mode, a dark theme in dark mode) and no worse than the old fixed
  white for the mismatched ones.
-->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="12121" systemVersion="16G29" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" colorMatched="YES" initialViewController="01J-lp-oVM">
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="12089"/>
    </dependencies>
    <scenes>
        <!--View Controller-->
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <layoutGuides>
                        <viewControllerLayoutGuide type="top" id="Ydg-fD-yQy"/>
                        <viewControllerLayoutGuide type="bottom" id="xbc-2k-c8Z"/>
                    </layoutGuides>
                    <view key="view" contentMode="scaleToFill" id="Ze5-6b-2t3">
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="iYj-Kq-Ea1" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="53" y="375"/>
        </scene>
    </scenes>
    <resources>
        <systemColor name="systemBackgroundColor">
            <color white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
        </systemColor>
    </resources>
</document>
