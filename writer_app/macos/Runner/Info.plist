<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!--
	  Google Drive OAuth redirect for ASWebAuthenticationSession. macOS reuses
	  the *iOS* OAuth client (Google has no macOS client type, and this app's
	  macOS and iOS bundle ids are identical — see AppInfo.xcconfig), so this
	  is the reverse-DNS form of the same client id supplied to the build as
	  --dart-define=GOOGLE_IOS_CLIENT_ID from the git-ignored .env.local, and
	  it must stay byte-identical to the ios/Runner/Info.plist entry. The two
	  MUST also equal AppleOAuthHelper.reversedScheme(GOOGLE_IOS_CLIENT_ID) or
	  ASWebAuthenticationSession cannot hand the redirect back to the app.
	  A public client with no secret; PKCE (S256) secures the exchange, so this
	  identifier is safe to keep in the tree.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.overengineeredhobbies.pellucid.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.153313615218-0r75r5q58qfn4n70ol44pf1fgjs9s2j3</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>http</string>
		<string>https</string>
	</array>
</dict>
</plist>
