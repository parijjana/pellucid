# Enforce LF line endings for all text files
* text=auto eol=lf

# Explicitly declare text files to always normalize to LF
*.dart text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.plist text eol=lf
*.java text eol=lf
*.kt text eol=lf
*.swift text eol=lf
*.h text eol=lf
*.m text eol=lf

# Denote binary files (do not normalize)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
